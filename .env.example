# Copy to .env.local and fill in. Never commit real values.
# On Railway the same names go into the service's Variables.

# --- Supabase (public: they are sent to the browser) -------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# --- Server only --------------------------------------------------------------------
# Supabase "service_role" key (Project Settings, API). Bypasses all access rules: it reads the
# bank keys, receives bank notifications and records refunds. Server only. Never in the
# browser, never in Git, never in a chat.
SUPABASE_SERVICE_ROLE_KEY=

# Password for POST /api/payments/reconcile (checking payments that waited too long for the
# bank). Any long random string, e.g.: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# Without it the route refuses everyone.
CRON_SECRET=

# Bank parameters (merchant id, secret key) are NOT environment variables here: every
# institution has its own, they are entered in the admin (Tickets, Payment methods) and stored
# per payment method. See docs/payments.md.
